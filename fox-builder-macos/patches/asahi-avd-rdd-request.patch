--- a/security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp
+++ b/security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp
@@ -995,6 +995,19 @@
 SandboxBrokerPolicyFactory::GetRDDPolicy(int aPid) {
   auto policy = MakeUnique<SandboxBroker::Policy>();
 
+#if defined(__aarch64__) && defined(MOZ_ENABLE_V4L2)
+  // Local Asahi AVD policy: these nodes were verified on this machine.
+  // Keep the exception in RDD and do not grant access to other media devices.
+  policy->AddPath(rdwr, "/dev/media0");
+  policy->AddPath(rdwr, "/dev/video0");
+  // Read only the AVD uevent metadata needed to resolve its video node.
+  // Include both the lookup path and the canonical path seen by the broker.
+  policy->AddPath(rdonly, "/sys/dev/char/81:0/uevent");
+  policy->AddPath(
+      rdonly,
+      "/sys/devices/platform/soc/269080000.avd/video4linux/video0/uevent");
+#endif
+
   AddSharedMemoryPaths(policy.get(), aPid);
 
   policy->AddPath(rdonly, "/dev/urandom");
