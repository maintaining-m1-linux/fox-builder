+ *    fox-builder fox-builder-macos/AVD_LINUX_DISASM.md)
+ *  - m1n1 proxyclient/m1n1/fw/avd/__init__.py (the original bring-up RE)
+ */
+struct avd_init_reg {
+	u32 off;
+	u32 val;
+	u8 or; /* 1: value is ORed with the current register contents */
+};
+
