+	{ 0x110cc90, 0xffffffff, 0 },	/* IRQ clear */
+	{ 0x110cc94, 0xffffffff, 0 },
+	{ 0x110ccd0, 0xffffffff, 0 },
+	{ 0x110ccd4, 0xffffffff, 0 },
+	{ 0x110cac8, 0xffffffff, 0 },
+	{ 0x1070024, 0x26907000, 0 },
+	{ 0x1400014, 0x0, 0 },
+};
